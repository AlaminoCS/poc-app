generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String             @id @default(uuid())
  email                 String             @unique
  passwordHash          String
  name                  String?
  birthDate             DateTime?          @db.Date
  timezone              String             @default("America/Sao_Paulo")
  notificationsEnabled  Boolean            @default(false)
  emailVerifiedAt       DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  challenges            LoginChallenge[]
  habits                Habit[]
  pushSubscriptions     PushSubscription[]
  consentEvents         ConsentEvent[]
}

model LoginChallenge {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  /// login | password_reset | password_change
  purpose    String    @default("login")
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([purpose])
}

model Habit {
  id            String         @id @default(uuid())
  userId        String
  title         String
  description   String?
  color         String         @default("#FF4D6D")
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  /// daily | weekdays | weekly | monthly
  frequency     String         @default("daily")
  /// 1=seg ... 7=dom (ISO)
  weekdays      Int[]          @default([])
  monthDay      Int?
  remindAtTime  String?
  remindEnabled Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns      HabitCheckIn[]
  reminderLogs  ReminderLog[]

  @@index([userId, active])
}

model HabitCheckIn {
  id        String   @id @default(uuid())
  habitId   String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReminderLog {
  id        String   @id @default(uuid())
  habitId   String
  date      DateTime @db.Date
  sentAt    DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model ConsentEvent {
  id            String   @id @default(uuid())
  userId        String?
  anonymousId   String?
  policyVersion String
  acceptedAt    DateTime @default(now())
  ipHash        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([policyVersion])
  @@index([anonymousId])
}

model ContactAttempt {
  id             String   @id @default(uuid())
  ipHash         String?
  uaHash         String?
  turnstileOk    Boolean  @default(false)
  honeypotHit    Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
