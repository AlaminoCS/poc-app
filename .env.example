# Database (Docker local or Neon)
DATABASE_URL=postgresql://poc:poc@localhost:5432/poc_habits?schema=public
DIRECT_URL=postgresql://poc:poc@localhost:5432/poc_habits?schema=public

# Auth
PASSWORD_PEPPER=change-me-long-random-pepper-value
JWT_SECRET=change-me-long-random-jwt-secret
JWT_EXPIRES_IN=1d
JWT_EXPIRES_IN_REMEMBER=30d
OTP_TTL_MINUTES=10
# true só em local/E2E — devolve debugOtp no login (nunca em produção pública)
ALLOW_TEST_OTP=false

# Resend
RESEND_API_KEY=re_xxxxxxxx
# Com domínio verificado (ex. alamino.dev.br) use um From desse domínio.
RESEND_FROM=Hábitos <noreply@alamino.dev.br>

# Web Push (web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vanderlei.jose.alamino@gmail.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Cron (Vercel env CRON_SECRET — enviado como Authorization Bearer)
CRON_SECRET=change-me-cron-secret

# Cloudflare Turnstile (free)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CONTACT_HMAC_SECRET=change-me-contact-hmac
CONTACT_TO_EMAIL=vanderlei.jose.alamino@gmail.com

# Apps
API_PORT=3001
CORS_ORIGIN=http://localhost:3000,https://poc.alamino.dev.br,https://poc-app-drab.vercel.app
API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.3.1
NEXT_PUBLIC_API_URL=
COOKIE_SECURE=false
